# Local development defaults. Production must override the values marked below.
API_BASE_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
DEBUG=false
ENVIRONMENT=development
AUTH_MODE=demo
ALLOW_DEMO_AUTH_IN_PRODUCTION=false
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_DEMO_AUTH_ENABLED=true
PERSISTENCE_BACKEND=sqlite
PERSISTENCE_STORAGE_DIR=.local_persistence
DATABASE_URL=
STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=.local_uploads
GCS_BUCKET_NAME=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SECRET=
JWT_JWKS_URL=
GOOGLE_OAUTH_CLIENT_ID=

# Filing provider defaults. Mock remains the safe local default.
FILING_PROVIDER=mock
FILING_PROVIDER_MODE=mock
SECRET_BACKEND=env
GCP_PROJECT_ID=
ALLOW_SANDBOX_PROVIDER_CALLS=false
ALLOW_LIVE_FILING=false
LIVE_FILING_APPROVAL_TICKET=
LIVE_FILING_APPROVED_BY=
LIVE_FILING_APPROVED_AT=
ERI_BASE_URL=
ERI_TOKEN_URL=
ERI_CLIENT_ID=
ERI_CLIENT_SECRET=
ERI_CLIENT_ID_SECRET_NAME=
ERI_CLIENT_SECRET_SECRET_NAME=
ERI_CALLBACK_URL=
ERI_CERT_PATH=
ERI_PRIVATE_KEY_SECRET_NAME=
ERI_CERT_SECRET_NAME=
ERI_SANDBOX_CLIENT_ID_SECRET_NAME=
ERI_SANDBOX_CLIENT_SECRET_SECRET_NAME=
ERI_SANDBOX_PRIVATE_KEY_SECRET_NAME=
ERI_SANDBOX_CERT_SECRET_NAME=
ERI_TIMEOUT_SECONDS=10
ERI_RETRY_COUNT=2
ERI_RETRY_BACKOFF_SECONDS=1
ERI_STATUS_POLL_INTERVAL_SECONDS=30
ALLOW_UNSIGNED_PROVIDER_CALLBACKS=false
STORE_PROVIDER_RAW_PAYLOADS=false
PROVIDER_RAW_PAYLOAD_RETENTION_DAYS=30

# Production required values:
# ENVIRONMENT=production
# DEBUG=false
# AUTH_MODE=jwt
# JWT_ISSUER=https://issuer.example.com/
# JWT_AUDIENCE=itr-api
# JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# PERSISTENCE_BACKEND=postgres
# DATABASE_URL=postgresql://...  # store in Secret Manager
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-private-itr-artifacts-bucket
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# NEXT_PUBLIC_API_BASE_URL=  # same-origin, or https://your-backend.example.com for split deployments
# NEXT_PUBLIC_AUTH_MODE=jwt
# NEXT_PUBLIC_DEMO_AUTH_ENABLED=false
# BACKEND_INTERNAL_URL=https://your-backend-service.example.com
