# Local development defaults. Production must override the values marked below.
API_BASE_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
DEBUG=false
ENVIRONMENT=development
AUTH_MODE=demo
ALLOW_DEMO_AUTH_IN_PRODUCTION=false
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_DEMO_AUTH_ENABLED=true
PERSISTENCE_BACKEND=sqlite
PERSISTENCE_STORAGE_DIR=.local_persistence
DATABASE_URL=
STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=.local_uploads
GCS_BUCKET_NAME=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SECRET=
JWT_JWKS_URL=
GOOGLE_OAUTH_CLIENT_ID=

# Production required values:
# ENVIRONMENT=production
# DEBUG=false
# AUTH_MODE=jwt
# JWT_ISSUER=https://issuer.example.com/
# JWT_AUDIENCE=itr-api
# JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# PERSISTENCE_BACKEND=postgres
# DATABASE_URL=postgresql://...  # store in Secret Manager
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-private-itr-artifacts-bucket
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# NEXT_PUBLIC_API_BASE_URL=  # same-origin, or https://your-backend.example.com for split deployments
# NEXT_PUBLIC_AUTH_MODE=jwt
# NEXT_PUBLIC_DEMO_AUTH_ENABLED=false
# BACKEND_INTERNAL_URL=https://your-backend-service.example.com
