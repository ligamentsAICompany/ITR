    "gross_total_income": {
      "type": "number",
      "minimum": 0
    },
    "salary_income": {
      "type": "number",
      "minimum": 0
    },
    "business_profession_income": {
      "type": "number"
    },
    "capital_gains_income": {
      "type": "number",
      "minimum": 0
    },
    "other_sources_income": {
      "type": "number"
    },
    "taxable_income": {
      "type": "number",
      "minimum": 0
    },
    "total_tax_liability": {
      "type": "number",
      "minimum": 0
    },
    "refund_due": {
      "type": "number",
      "minimum": 0
    },
    "tax_payable": {
      "type": "number",
      "minimum": 0
    },
    "tds_salary": {
      "type": "number",
      "minimum": 0
    },
    "tds_other": {
      "type": "number",
      "minimum": 0
    },
    "tcs": {
      "type": "number",
      "minimum": 0
    }
  },
  "x-itr": {
    "assessment_year": "2026-27",
    "previous_year": "2025-26",
    "itr_form": "ITR-2",
    "schema_version": "synthetic-demo-itr2-ay2026-27-v1",
    "schema_kind": "synthetic_demo_test",
    "disclaimer": "Synthetic test schema pack only. Not official government schema. For demo validation only."
  },
  "x-itr-field-map": {}
}
