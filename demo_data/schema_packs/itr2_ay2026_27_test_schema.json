{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.local/schemas/itr2-ay2026-27-synthetic-test.schema.json",
  "title": "Synthetic Demo ITR-2 AY 2026-27 Export Test Schema",
  "description": "Synthetic test schema pack only. Not official government schema. For demo validation only.",
  "type": "object",
  "required": [
