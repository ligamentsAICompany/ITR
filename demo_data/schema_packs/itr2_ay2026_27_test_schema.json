    "previous_year": {
      "type": "string",
      "const": "2025-26"
    },
    "itr_form": {
      "type": "string",
      "const": "ITR-2"
    },
    "candidate_itr": {
      "type": "string",
      "const": "ITR-2"
    },
    "selected_regime": {
      "type": "string",
      "enum": ["old", "new"]
